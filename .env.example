# Local development environment. Copy to .env (git-ignored) and adjust.
# `task dev:up` starts MongoDB, Redis, Kafka (+Kafdrop UI) and Jaeger with these values.

ENV=dev

# --- MongoDB (dev/docker/docker-compose.yaml) ---------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGODB_URI_PRIMARY=mongodb://localhost:27017/?authSource=admin
MONGODB_USERNAME_PRIMARY=root
MONGODB_PASSWORD_PRIMARY=password

# --- Redis ----------------------------------------------------------------------
CACHE_ADDRESS=localhost:6379
CACHE_PASSWORD=redis-password
CACHE_TLS_ENABLED=false
CACHE_TYPE=redis

# --- Event broker: kafka (local) | pubsub (cloud) -------------------------------
NOTIFICATION_BROKER=kafka
KAFKA_BROKERS=localhost:9092
# KRaft cluster id for the single local broker (any base64 UUID)
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# GCP_PROJECT_ID=your-gcp-project   # required when NOTIFICATION_BROKER=pubsub

# --- Auth -----------------------------------------------------------------------
# Use a high-entropy secret outside local dev: openssl rand -base64 48
# Release mode refuses to start with a weak key.
JWT_KEY=local-dev-signing-secret-change-me-0123456789abcdef
# JWT_KEY_PREVIOUS=                 # only during a zero-downtime key rotation
# TRUSTED_PROXY_CIDR=10.0.0.0/8     # stg/prod: CIDR of the load balancer / ingress

# --- Observability (Jaeger all-in-one from docker-compose) -------------------------
OTEL_ENDPOINT=localhost:4317

# --- Snowflake IDs: every running instance needs a unique (datacenter, worker) pair -
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1
