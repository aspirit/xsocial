# Single source of truth for every toolchain / infrastructure version.
#
# Consumers:
#   - Taskfile.yaml        (dotenv) → docker build args, swag/golangci versions
#   - dev/docker compose   (--env-file) → local MongoDB / Redis / Kafka / Jaeger images
#   - GitHub Actions       (loaded into $GITHUB_ENV by the workflow)
#   - GitLab CI            (.gitlab-ci.variables.yml, generated by `task sync:ci-vars`)
#
# The pre-commit hook regenerates the CI variables and CI fails on drift, so a
# version bump is a one-line change that propagates everywhere.
GO_VERSION=1.26.0
DOCKER_VERSION=29.2.0
ALPINE_VERSION=3.23.3
MONGO_VERSION=8.2.5
REDIS_VERSION=8.6.0
KAFKA_VERSION=8.1.1
KAFDROP_VERSION=4.2.0
GOLANGCI_LINT_VERSION=2.9.0
SWAG_VERSION=1.16.6
WIRE_VERSION=0.7.0
JAEGER_VERSION=1.76.0
